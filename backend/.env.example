# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string.
# Local (Docker): postgresql://postgres:secret@localhost:5432/movieapp?schema=public
# Prisma Postgres (prod, pooled): postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:secret@localhost:5432/movieapp?schema=public"

# Optional direct connection string; currently unused by the application and Prisma config.
# Prisma Postgres (prod, direct): postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# Local (Docker): same as DATABASE_URL
DIRECT_URL="postgresql://postgres:secret@localhost:5432/movieapp?schema=public"

# ─── JWT ────────────────────────────────────────────────────
# Secret key for signing tokens. MUST be changed in production.
JWT_SECRET="super-secret-key-change-me"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="7d"

# ─── App ────────────────────────────────────────────────────
# development | production
NODE_ENV="development"
PORT=3000

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local: http://localhost:5173
# Prod: https://the-movies-app.layero.app
FRONTEND_URL=http://localhost:5173
